<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- docs/en/10-android-permissions.md — minimal set, everything justified -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Legacy public Downloads access on Android 8–9 only (API 26–28) -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:name=".EndlessSeaApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Endless Sea"
        android:theme="@style/Theme.EndlessSea"
        android:usesCleartextTraffic="false"
        android:supportsRtl="true"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTask">
            <!-- Local playback of user videos (spec §7 : lecteur de fichiers locaux) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="endlesssea" android:host="media" />
            </intent-filter>
        </activity>

        <!-- Selectable launcher icons. Never disable the actual activity. -->
        <activity-alias
            android:name="dev.endlesssea.app.launcher.BlueWhite"
            android:targetActivity="dev.endlesssea.app.MainActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/app_logo_blue_white"
            android:label="Endless Sea">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name="dev.endlesssea.app.launcher.Glacier"
            android:targetActivity="dev.endlesssea.app.MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/app_logo_glacier"
            android:label="Endless Sea">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name="dev.endlesssea.app.launcher.Cyan"
            android:targetActivity="dev.endlesssea.app.MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/app_logo_cyan"
            android:label="Endless Sea">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name="dev.endlesssea.app.launcher.Ocean"
            android:targetActivity="dev.endlesssea.app.MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/app_logo_ocean"
            android:label="Endless Sea">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name="dev.endlesssea.app.launcher.Silver"
            android:targetActivity="dev.endlesssea.app.MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/app_logo_silver"
            android:label="Endless Sea">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name="dev.endlesssea.app.launcher.Ember"
            android:targetActivity="dev.endlesssea.app.MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/app_logo_ember"
            android:label="Endless Sea">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name="dev.endlesssea.app.launcher.Adventure"
            android:targetActivity="dev.endlesssea.app.MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/app_logo_adventure"
            android:label="Endless Sea">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name="dev.endlesssea.app.launcher.Classic"
            android:targetActivity="dev.endlesssea.app.MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/app_logo_classic"
            android:label="Endless Sea">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Lecteur immersif (spec §7) -->
        <activity
            android:name=".ui.player.PlayerActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false"
            android:launchMode="singleTask" />

        <activity android:name=".ui.details.TrailerActivity" android:exported="false" />

        <!-- CAPTCHA / anti-bot verification (spec §3) -->
        <activity
            android:name="dev.endlesssea.extensions.loader.captcha.CaptchaActivity"
            android:exported="false" />

        <!-- Download foreground service (typed dataSync, API 34+) -->
        <service
            android:name="dev.endlesssea.downloader.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
            <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="dev.endlesssea.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
